{
  "name": "baram",
  "private": true,
  "version": "0.5.1",
  "license": "Apache-2.0",
  "type": "module",
  "packageManager": "npm@11.9.0",
  "engines": {
    "node": ">=24.14 <25",
    "npm": ">=11.9 <12"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.node.json --noEmit && tsc -p tsconfig.test.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "npm run version:check && npm run lint:frontend",
    "lint:frontend": "npm run format:check && npm run lint:ts && npm run lint:css && npm run lint:doc-comments && npm run typecheck && npm run knip:ci && npm run types:plugin:check && npm run validate:revocations && npm run validate:index && npm run audit:css-vars && npm run tokens:check",
    "validate:revocations": "tsx scripts/validate-revocations.ts registry/revoked.json",
    "validate:index": "tsx scripts/validate-index.ts registry/index.json",
    "validate:registry-assets": "tsx scripts/validate-registry-assets.ts",
    "lint:doc-comments": "node scripts/check-doc-comments.mjs",
    "lint:ts": "eslint src/ --max-warnings=0",
    "lint:css": "stylelint 'src/**/*.css' --max-warnings=0",
    "rust:fmt": "cargo fmt --manifest-path src-tauri/Cargo.toml --check",
    "rust:prepare": "npm run build",
    "rust:_clippy": "cargo clippy --manifest-path src-tauri/Cargo.toml --all-targets -- -D warnings",
    "rust:_test": "cargo test --manifest-path src-tauri/Cargo.toml",
    "rust:clippy": "npm run rust:prepare && npm run rust:_clippy",
    "rust:test": "npm run rust:prepare && npm run rust:_test",
    "rust:check": "npm run rust:fmt && npm run rust:prepare && npm run rust:_clippy && npm run rust:_test",
    "check": "npm run lint && npm run test",
    "verify:ci": "npm run check && npm run rust:check",
    "format": "prettier --write 'src/**/*.{ts,tsx,css}'",
    "format:check": "prettier --check 'src/**/*.{ts,tsx,css}'",
    "knip": "knip",
    "knip:ci": "knip --reporter compact",
    "tokens:build": "npx tsx style-dictionary.config.ts && prettier --write --log-level warn 'src/styles/generated/*.css' && stylelint --fix --quiet 'src/styles/generated/*.css'",
    "tokens:export": "npx tsx scripts/export-tokens-studio.ts",
    "tokens:check": "npm run tokens:build && npm run tokens:export && git diff --exit-code src/styles/generated tokens/tokens-studio.json",
    "types:plugin": "tsc -p tsconfig.plugin-api.json && mv examples/plugins/public-api.d.ts examples/plugins/plugin-api.d.ts",
    "types:plugin:check": "npm run types:plugin && git diff --exit-code examples/plugins/*.d.ts",
    "audit:css-vars": "npx tsx scripts/audit-css-vars.ts",
    "version:check": "node ./scripts/check-version-sync.mjs",
    "site:build": "node site/build-docs.mjs",
    "site:test": "node --test site/*.test.mjs",
    "prepare": "husky"
  },
  "dependencies": {
    "@codemirror/commands": "^6.10.4",
    "@codemirror/lang-cpp": "^6.0.3",
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-go": "^6.0.1",
    "@codemirror/lang-html": "^6.4.12",
    "@codemirror/lang-java": "^6.0.2",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/lang-php": "^6.0.2",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/lang-rust": "^6.0.2",
    "@codemirror/lang-sql": "^6.10.0",
    "@codemirror/lang-xml": "^6.1.0",
    "@codemirror/lang-yaml": "^6.1.3",
    "@codemirror/language": "^6.12.4",
    "@codemirror/legacy-modes": "^6.5.3",
    "@codemirror/state": "^6.7.1",
    "@codemirror/view": "^6.43.8",
    "@floating-ui/dom": "^1.8.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-clipboard-manager": "^2.3.2",
    "@tauri-apps/plugin-dialog": "^2.7.2",
    "@tauri-apps/plugin-opener": "^2",
    "@tauri-apps/plugin-process": "^2.3.1",
    "@tauri-apps/plugin-updater": "^2.10.1",
    "@tiptap/extension-document": "^3.29.2",
    "@tiptap/extension-dropcursor": "^3.29.2",
    "@tiptap/extension-gapcursor": "^3.29.2",
    "@tiptap/extension-hard-break": "^3.29.2",
    "@tiptap/extension-history": "^3.29.2",
    "@tiptap/extension-placeholder": "^3.29.2",
    "@tiptap/extension-table": "^3.29.2",
    "@tiptap/extension-table-cell": "^3.29.2",
    "@tiptap/extension-table-header": "^3.29.2",
    "@tiptap/extension-table-row": "^3.29.2",
    "@tiptap/extension-text": "^3.29.2",
    "@tiptap/pm": "^3.29.2",
    "@tiptap/react": "^3.29.2",
    "@tiptap/suggestion": "^3.29.2",
    "@types/mdast": "^4.0.4",
    "codemirror-lang-latex": "^0.6.1",
    "cytoscape": "^3.33.1",
    "d3-force": "^3.0.0",
    "dompurify": "^3.4.13",
    "fast-diff": "^1.3.0",
    "katex": "^0.16.28",
    "lucide-react": "^1.28.0",
    "mdast-util-from-markdown": "^2.0.2",
    "mdast-util-gfm": "^3.1.0",
    "mdast-util-to-markdown": "^2.1.2",
    "mdast-util-to-string": "^4.0.0",
    "mermaid": "^11.16.1",
    "pdfjs-dist": "^6.2.108",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "remark-frontmatter": "^5.0.0",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "remark-parse": "^11.0.0",
    "remark-stringify": "^11.0.0",
    "tailwindcss": "^4.1.18",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.1.0",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.0.2",
    "@eslint/js": "^10.0.1",
    "@tauri-apps/cli": "^2",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@types/d3-force": "^3.0.10",
    "@types/node": "^26.1.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-perfectionist": "^5.10.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "husky": "^9.1.7",
    "jsdom": "^30.0.1",
    "knip": "^6.29.0",
    "lint-staged": "^17.3.0",
    "marked": "^18.0.7",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "style-dictionary": "^5.5.0",
    "stylelint": "^17.14.1",
    "stylelint-config-recess-order": "^7.7.0",
    "stylelint-config-standard": "^40.0.0",
    "tsx": "^4.23.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.66.0",
    "vite": "^8.2.1",
    "vitest": "^4.1.10"
  }
}
