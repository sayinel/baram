{
  "name": "baram-site",
  "private": true,
  "type": "module",
  "description": "Baram 홈페이지 + 문서 사이트. 앱과 의존성을 분리한다 (dev/design/specs/2026-09-06-docs-site-i18n-restructure-design.md).",
  "scripts": {
    "build": "astro build",
    "check": "astro check && npm run check:pages",
    "check:dist": "node scripts/check-dist.mjs",
    "check:pages": "node scripts/check-pages.mjs",
    "dev": "astro dev",
    "preview": "astro preview",
    "test": "node --test tests/*.test.mjs",
    "verify": "npm run build && npm run check:dist && npm run check:pages && npm test && astro check"
  },
  "dependencies": {
    "@astrojs/starlight": "0.42.0",
    "astro": "7.3.1",
    "sharp": "0.34.4"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "starlight-links-validator": "0.26.0",
    "typescript": "^6.0.3"
  }
}
