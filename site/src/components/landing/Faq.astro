---
import { useTranslations, type Locale, type MessageKey } from "../../i18n";
import { docPath, withBase } from "../../../routes.mjs";
const { locale } = Astro.props as { locale: Locale };
const t = useTranslations(locale);

const ITEMS = [1, 2, 3, 4, 5, 6] as const;
---
<section id="faq" class="section section-alt">
  <div class="container">
    <h2>{t("faq.title")}</h2>
    {ITEMS.map((n) => (
      <details class="faq-item">
        <summary>{t(`faq.q${n}` as MessageKey)}</summary>
        <p>{t(`faq.a${n}` as MessageKey)}</p>
      </details>
    ))}
    <a class="see-all" href={withBase(docPath("faq/general", locale))}>{t("faq.seeAll")}</a>
  </div>
</section>
