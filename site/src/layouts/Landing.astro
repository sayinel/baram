---
// 랜딩 페이지 셸 — nav · footer · head. Starlight 레이아웃 밖이다(디자인 자유도).
// 언어는 URL 이 정한다 — 옛 `localStorage` + `data-i18n` 치환은 폐기했다.
import { docPath, withBase } from "../../routes.mjs";
import logoDark from "../assets/baram-logo-dark.png";
import logoLight from "../assets/baram-logo.png";
import { LOCALE_LABELS, otherLocale, useTranslations, type Locale } from "../i18n";
import "../styles/site.css";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);
const other = otherLocale(locale);

// nav·푸터의 "문서" 는 **문서 홈**으로 보낸다 — 거기가 시작 경로·주제 카드·자주
// 찾는 것을 한자리에 놓은 안내면이다. 앱 도움말의 "사용 설명서" 는 이것과 별개로
// help-routes.json 의 entries.guide 가 정하고, 그쪽은 시작하기 페이지로 직행한다.
const docsHome = withBase(docPath("index", locale));

const title = "Baram — Lightweight WYSIWYG Markdown Editor";
const description = t("hero.sub");
const canonical = new URL(withBase(`/${locale}/`), Astro.site).href;
const ogImage = new URL(withBase("/assets/hero.png"), Astro.site).href;
---

<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang={other} href={new URL(withBase(`/${other}/`), Astro.site).href} />
    <link rel="alternate" hreflang="x-default" href={new URL(withBase("/"), Astro.site).href} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="icon" type="image/png" href={withBase("/assets/favicon.png")} />
    <link rel="apple-touch-icon" href={withBase("/assets/apple-touch-icon.png")} />
    <script is:inline>
      // Starlight 과 같은 계약을 쓴다: localStorage['starlight-theme'] → dataset.theme.
      // 인라인·동기 실행이어야 첫 페인트 전에 적용돼 깜박임이 없다.
      (() => {
        try {
          const stored = localStorage.getItem("starlight-theme");
          if (stored === "light" || stored === "dark") {
            document.documentElement.dataset.theme = stored;
          }
        } catch {
          /* private 모드 등 — 시스템 설정을 그대로 따른다 */
        }
      })();
    </script>
  </head>
  <body>
    <header class="nav">
      <div class="container nav-inner">
        <a class="nav-logo" href={withBase(`/${locale}/`)}>
          {/* ‼️ `<picture media="(prefers-color-scheme: dark)">` 이었다. `<picture>` 의 선택은
              OS 설정만 보고 `[data-theme]` 을 보지 않는데, 이 사이트의 테마는 3-상태다
              (기본 · prefers-color-scheme · [data-theme]). 그래서 OS 가 라이트인데 토글(◐)로
              다크를 고르면 **어두운 잉크 워드마크가 어두운 nav 에 올라가 글자가 거의 안 보였다** —
              옛 마크업을 실제 페이지에 되돌려 렌더해 확인한 증상이다. 둘 다 내고 CSS 가
              고르게 한다(site.css 의 3-상태 규칙) — Starlight 이 자기 로고에 쓰는 방식. */}
          <img class="logo-light" src={logoLight.src} width={logoLight.width} height={logoLight.height} alt="Baram" />
          <img class="logo-dark" src={logoDark.src} width={logoDark.width} height={logoDark.height} alt="Baram" />
        </a>
        <nav class="nav-links">
          <a href="#features">{t("nav.features")}</a>
          <a href="#shortcuts">{t("nav.shortcuts")}</a>
          <a href="#plugins">{t("nav.plugins")}</a>
          <a href="#install">{t("nav.install")}</a>
          <a href="#faq">{t("nav.faq")}</a>
          <a href={docsHome}>{t("nav.docs")}</a>
        </nav>
        <div class="nav-actions">
          <a class="lang-toggle" href={withBase(`/${other}/`)} hreflang={other} lang={other}>
            {LOCALE_LABELS[other]}
          </a>
          <button id="theme-toggle" class="lang-toggle" type="button" aria-label="Toggle theme">◐</button>
          <a class="github-badge" href="https://github.com/sayinel/baram" aria-label="Star Baram on GitHub">
            ★ <span id="github-stars">GitHub</span>
          </a>
        </div>
      </div>
    </header>
    <main>
      <slot />
    </main>
    <footer class="footer">
      <div class="container">
        <span>{t("footer.tagline")}</span>
        <nav>
          <a href="https://github.com/sayinel/baram">GitHub</a>
          <a href="https://github.com/sayinel/baram/releases">{t("footer.releases")}</a>
          <a href={docsHome}>{t("footer.docs")}</a>
        </nav>
      </div>
    </footer>
    <script>
      import { initLanding } from "../scripts/landing";
      initLanding();
    </script>
  </body>
</html>
