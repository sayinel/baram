        "text": "🧪 smoke",
        "tooltip": "Click to run the sandbox boundary checks"
      },
      { "id": "file", "text": "📄 —", "tooltip": "File the sandbox was told about" }
    ]
  },
  "icon": "🧪",
  "keywords": ["internal", "smoke", "sandbox"]
}
